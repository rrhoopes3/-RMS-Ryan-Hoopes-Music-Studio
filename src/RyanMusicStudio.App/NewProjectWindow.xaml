<Window x:Class="RyanMusicStudio.App.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New song — RMS"
        Height="460" Width="660"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BoothBrush}"
        Foreground="{StaticResource CreamBrush}"
        ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="New song" FontFamily="Segoe UI Semibold" FontSize="24"/>
        <TextBlock Text="Start with drum and melody pads plus an armed voice track. Add more tracks as you go." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,16"/>
        <TextBlock Text="Song name"/>
        <TextBox x:Name="NameBox" Text="My song" Margin="0,4,0,12"/>
        <TextBlock Text="Folder"/>
        <DockPanel Margin="0,4,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="Browse" Click="Browse_Click" Margin="8,0,0,0"/>
            <TextBox x:Name="FolderBox"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal">
            <StackPanel Width="140">
                <TextBlock Text="Tempo"/>
                <TextBox x:Name="TempoBox" Text="90"/>
            </StackPanel>
            <StackPanel Width="100" Margin="16,0,0,0">
                <TextBlock Text="Beats"/>
                <TextBox x:Name="NumBox" Text="4"/>
            </StackPanel>
            <StackPanel Width="100" Margin="16,0,0,0">
                <TextBlock Text="Note"/>
                <TextBox x:Name="DenBox" Text="4"/>
            </StackPanel>
            <StackPanel Width="140" Margin="16,0,0,0">
                <TextBlock Text="Sample rate"/>
                <ComboBox x:Name="RateBox">
                    <ComboBoxItem Content="48 kHz" IsSelected="True"/>
                    <ComboBoxItem Content="44.1 kHz"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Style="{StaticResource PlainButton}" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Create song" Click="Create_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>

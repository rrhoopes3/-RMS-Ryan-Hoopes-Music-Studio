<Window x:Class="RyanMusicStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RMS"
        Height="900" Width="1180" MinHeight="760" MinWidth="1020"
        Background="#E7EEF2"
        Foreground="#1A2428"
        FontFamily="Segoe UI"
        FontSize="18"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        Closing="OnClosing"
        PreviewKeyDown="OnKeyDown">
    <Window.Resources>
        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Background" Value="#0E7C66"/>
            <Setter Property="Foreground" Value="#F7FBFC"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="MinHeight" Value="76"/>
            <Setter Property="Padding" Value="28,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource PlayButton}">
            <Setter Property="Background" Value="#1A2428"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="#F7FBFC"/>
            <Setter Property="Foreground" Value="#1A2428"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#C5D0D6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="KeyButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="RoundStep" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="32,24,32,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SaveButton" Content="Save" Style="{StaticResource QuietButton}" Margin="0,0,10,0" Click="Save_Click"/>
                <Button x:Name="OpenButton" Content="Open" Style="{StaticResource QuietButton}" Click="Open_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Your song" FontFamily="Georgia" FontSize="36" FontWeight="Bold"/>
                <TextBlock x:Name="SongName" Text="Opening your song…" FontSize="16" Foreground="#5C6B72" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,20,32,16">
                <Border x:Name="Banner" Visibility="Collapsed" Background="#FFF4E5" BorderBrush="#E2C08A" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
                    <TextBlock x:Name="BannerText" TextWrapping="Wrap" FontSize="18"/>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Button x:Name="PlayButton" Content="Play" Style="{StaticResource PlayButton}" Click="Play_Click" AutomationProperties.Name="Play"/>
                    <Button x:Name="StopButton" Content="Stop" Style="{StaticResource StopButton}" Margin="12,0,0,0" Click="Stop_Click" AutomationProperties.Name="Stop"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Tempo" Width="92" VerticalAlignment="Center" FontSize="20"/>
                    <Button Content="−" Style="{StaticResource RoundStep}" Click="TempoDown_Click" AutomationProperties.Name="Slower"/>
                    <TextBlock x:Name="TempoText" Text="100" Width="78" FontSize="32" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="+" Style="{StaticResource RoundStep}" Click="TempoUp_Click" AutomationProperties.Name="Faster"/>
                    <TextBlock x:Name="PositionText" Margin="28,0,0,0" VerticalAlignment="Center" FontSize="22" Text="Step 1 of 16"/>
                </StackPanel>

                <Grid Margin="0,6,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Volume" VerticalAlignment="Center" FontSize="20"/>
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="80"
                            VerticalAlignment="Center" Height="32" TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="Volume_Changed" AutomationProperties.Name="Volume"/>
                    <TextBlock x:Name="VolumeText" Grid.Column="2" Text="80" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <TextBlock Text="Drums" FontSize="22" FontWeight="SemiBold" Margin="0,18,0,8"/>
                <Grid x:Name="DrumGrid"/>

                <TextBlock Text="Melody" FontSize="22" FontWeight="SemiBold" Margin="0,22,0,2"/>
                <TextBlock Text="Tap a piano key, then tap a box." Foreground="#5C6B72" Margin="0,0,0,10"/>
                <StackPanel x:Name="PianoRow" Orientation="Horizontal"/>
                <Grid x:Name="MelodyGrid" Margin="0,12,0,0"/>
                <TextBlock x:Name="EmptyText" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="#5C6B72"
                           Text="This song is quiet. Tap the drum boxes or piano keys, then press Play."/>

                <Button x:Name="RecordButton" Content="Record my voice" Style="{StaticResource QuietButton}"
                        HorizontalAlignment="Left" MinWidth="260" MinHeight="64" Margin="0,22,0,0"
                        Click="Record_Click" AutomationProperties.Name="Record my voice"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F7FBFC" BorderBrush="#D5DEE3" BorderThickness="0,1,0,0" Padding="32,14">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="18" Text="Opening your song…"/>
        </Border>
    </Grid>
</Window>

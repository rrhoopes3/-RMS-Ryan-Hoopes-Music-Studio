<Window x:Class="RyanMusicStudio.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:RyanMusicStudio.App.Controls"
 Title="RMS" Height="980" Width="1320" MinHeight="760" MinWidth="1020"
 Background="#E7EEF2" Foreground="#1A2428" FontFamily="Segoe UI" FontSize="14"
 WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnKeyDown"
 AllowDrop="True" DragOver="Audio_DragOver" Drop="Audio_Drop">
 <Window.Resources>
  <Style x:Key="QuietButton" TargetType="Button">
   <Setter Property="Background" Value="#F7FBFC"/><Setter Property="Foreground" Value="#1A2428"/>
   <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="12,5"/>
   <Setter Property="Margin" Value="0,0,6,4"/><Setter Property="BorderBrush" Value="#C5D0D6"/>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource QuietButton}"/>
  <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
   <Setter Property="Width" Value="44"/><Setter Property="Height" Value="36"/>
   <Setter Property="Margin" Value="2"/><Setter Property="Padding" Value="0"/>
  </Style>
  <Style x:Key="KeyButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
   <Setter Property="Width" Value="58"/><Setter Property="Height" Value="40"/>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="30"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="TextBox"><Setter Property="MinHeight" Value="30"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid Margin="20,14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button x:Name="NewButton" Content="New song" Click="New_Click"/>
    <Button x:Name="OpenButton" Content="Open" Click="Open_Click"/>
    <Button x:Name="SaveButton" Content="Save" Click="Save_Click"/>
    <Button x:Name="SaveAsButton" Content="Save as…" Click="SaveAs_Click"/>
   </StackPanel>
   <StackPanel><TextBlock Text="RMS · Your studio" FontFamily="Georgia" FontSize="26" FontWeight="Bold"/>
    <TextBlock x:Name="SongName" Text="Opening your song…" Foreground="#5C6B72" Margin="0,2,0,8"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="#F7FBFC" CornerRadius="10" Padding="12" Margin="0,4,0,10">
   <StackPanel>
    <WrapPanel VerticalAlignment="Center">
     <Button x:Name="PlayButton" Content="Play / Pause" Background="#0E7C66" Foreground="White" FontSize="18" Click="Play_Click"/>
     <Button x:Name="StopButton" Content="Stop" FontSize="18" Click="Stop_Click"/>
     <Button Content="Return to start" Click="Start_Click"/>
     <Button x:Name="RecordButton" Content="Record" FontSize="18" Click="Record_Click" AutomationProperties.Name="Record armed track"/>
     <TextBlock x:Name="RecordingState" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
     <TextBlock x:Name="PositionText" Margin="12,0" VerticalAlignment="Center" FontFamily="Consolas"/>
    </WrapPanel>
    <Grid Margin="0,8,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Microphone / input"/><ComboBox x:Name="MicBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Mic_Changed" AutomationProperties.Name="Audio input"/>
      <controls:MeterBar x:Name="InputMeter" Height="16" Margin="0,5,0,0" AutomationProperties.Name="Input level"/>
     </StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="Speakers / output"/><ComboBox x:Name="SpeakerBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Speaker_Changed" AutomationProperties.Name="Audio output"/>
      <controls:MeterBar x:Name="OutputMeter" Height="16" Margin="0,5,0,0" AutomationProperties.Name="Output level"/>
     </StackPanel>
    </Grid>
    <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
     <TextBlock Text="Tempo" VerticalAlignment="Center" Margin="0,0,6,0"/>
     <Button Content="−" Click="TempoDown_Click" AutomationProperties.Name="Slower"/>
     <TextBlock x:Name="TempoText" Text="100" Width="42" VerticalAlignment="Center" TextAlignment="Center"/>
     <Button Content="+" Click="TempoUp_Click" AutomationProperties.Name="Faster"/>
     <Button Content="Click on/off" Click="Metronome_Click"/>
     <TextBlock Text="Master volume" VerticalAlignment="Center" Margin="14,0,6,0"/>
     <Slider x:Name="VolumeSlider" Width="150" Minimum="0" Maximum="100" Value="80" ValueChanged="Volume_Changed" VerticalAlignment="Center" AutomationProperties.Name="Master volume"/>
     <TextBlock x:Name="VolumeText" Width="32" VerticalAlignment="Center" Margin="6,0"/>
     <TextBlock x:Name="ArmedText" Margin="12,0,0,0" VerticalAlignment="Center"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <Border x:Name="Banner" Grid.Row="2" Visibility="Collapsed" Background="#FFF4E5" Padding="10" Margin="0,0,0,8">
   <TextBlock x:Name="BannerText" TextWrapping="Wrap"/>
  </Border>
  <Grid Grid.Row="3">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel x:Name="TrackTools">
     <TextBox x:Name="TrackNameBox" Width="140" Text="My voice" Margin="0,0,6,4" AutomationProperties.Name="New track name"/>
     <ComboBox x:Name="TrackTypeBox" Width="88" SelectedIndex="0" Margin="0,0,6,4" AutomationProperties.Name="New track type"><ComboBoxItem Content="Voice"/><ComboBoxItem Content="Guitar"/><ComboBoxItem Content="Other"/></ComboBox>
     <Button Content="+ Track" Click="AddTrack_Click"/><Button Content="Arm selected" Click="Arm_Click"/>
     <Button Content="Import WAV / MP3" Click="Import_Click"/>
    </WrapPanel>
    <WrapPanel x:Name="EditTools" Grid.Row="1">
     <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click"/><Button x:Name="RedoButton" Content="Redo" Click="Redo_Click"/>
     <Button Content="Split" Click="Split_Click"/><Button Content="Delete" Click="Delete_Click"/>
     <Button Content="Zoom −" Click="ZoomOut_Click"/><Button Content="Zoom +" Click="ZoomIn_Click"/>
     <Button x:Name="LoopButton" Content="Loop off" Click="Loop_Click"/><Button x:Name="PunchButton" Content="Punch off" Click="Punch_Click"/>
     <Button x:Name="CompButton" Content="Choose takes" Click="Comp_Click"/>
    </WrapPanel>
    <Border Grid.Row="2" Background="#1A2428" MinHeight="130">
     <controls:TimelinePanel x:Name="Timeline" AutomationProperties.Name="Song timeline"/>
    </Border>
    <TextBlock Grid.Row="3" Text="Click the ruler to seek; drag across it to select a range. Drag clips to move. Wheel scrolls lanes; Shift+wheel scrolls time." TextWrapping="Wrap" Foreground="#5C6B72" Margin="0,5"/>
   </Grid>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Track mixer" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,6"/>
    <controls:TrackMixerPanel x:Name="Mixer" Grid.Row="1" Background="#202B31"/>
   </Grid>
   <Expander Grid.Row="1" Grid.ColumnSpan="3" Header="Drums &amp; melody · tap pads to build your song" IsExpanded="False" Margin="0,8,0,0">
    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
     <StackPanel Margin="8">
      <Grid x:Name="DrumGrid"/><TextBlock Text="Melody · choose a piano key, then tap a step" Margin="0,8"/>
      <StackPanel x:Name="PianoRow" Orientation="Horizontal"/><Grid x:Name="MelodyGrid"/>
      <TextBlock x:Name="EmptyText" Text="Tap drum pads or melody steps, or add a track and record." Margin="0,8" Foreground="#5C6B72"/>
     </StackPanel>
    </ScrollViewer>
   </Expander>
  </Grid>
  <StackPanel Grid.Row="4" Margin="0,10,0,0">
   <WrapPanel x:Name="ExportTools">
    <TextBlock Text="Export" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <ComboBox x:Name="ExportFormatBox" Width="118" SelectedIndex="0" Margin="0,0,8,0" AutomationProperties.Name="Export format"><ComboBoxItem Content="WAV 16-bit"/><ComboBoxItem Content="WAV 24-bit"/><ComboBoxItem Content="MP3"/></ComboBox>
    <ComboBox x:Name="ExportScopeBox" Width="160" SelectedIndex="0" Margin="0,0,8,0" AutomationProperties.Name="Export scope"><ComboBoxItem Content="Whole mix"/><ComboBoxItem Content="Selected range"/><ComboBoxItem Content="Voice stem"/><ComboBoxItem Content="Backing stem"/></ComboBox>
    <Button x:Name="ExportButton" Content="Export audio…" Click="Export_Click"/>
    <ProgressBar x:Name="ExportProgress" IsIndeterminate="True" Width="140" Height="12" Visibility="Collapsed" AutomationProperties.Name="Export in progress"/>
   </WrapPanel>
   <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,5,0,0" Text="Opening your song…"/>
  </StackPanel>
 </Grid>
</Window>

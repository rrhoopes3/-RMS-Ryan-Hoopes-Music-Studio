<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RMS</AssemblyName>
    <RootNamespace>RyanMusicStudio.Desktop</RootNamespace>
    <Version>1.2.0</Version>
    <DefineConstants>$(DefineConstants);PORTABLE</DefineConstants>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../RyanMusicStudio.Core/RyanMusicStudio.Core.csproj" />
    <ProjectReference Include="../RyanMusicStudio.Engine/RyanMusicStudio.Engine.csproj" />
    <Compile Include="../RyanMusicStudio.App/SessionController.cs" Link="SessionController.cs" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
  </ItemGroup>
</Project>

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RyanMusicStudio.Desktop.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#C99462" RegionColor="#181512"
                    AltHigh="#181512" AltMedium="#211D19" AltLow="#27211C"
                    ChromeLow="#1E1A16" ChromeMediumLow="#2A241E" ChromeHigh="#473B30"
                    BaseHigh="#F1E8DA" BaseMedium="#BBAE9E" ListLow="#332A22" ListMedium="#493A2D" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <Style Selector="Window">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Inter"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#302821"/>
            <Setter Property="Foreground" Value="#EEE5D6"/>
            <Setter Property="BorderBrush" Value="#514133"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#453629"/>
            <Setter Property="BorderBrush" Value="#99724F"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#C99462"/>
            <Setter Property="Foreground" Value="#211810"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#D9AD7F"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DCAD7C"/>
            <Setter Property="Foreground" Value="#211810"/>
        </Style>
        <Style Selector="Button.record">
            <Setter Property="Background" Value="#A74339"/>
            <Setter Property="BorderBrush" Value="#C56555"/>
            <Setter Property="Foreground" Value="#FFF2E8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.record:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#BD5346"/>
            <Setter Property="Foreground" Value="#FFF2E8"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinWidth" Value="138"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#E3B888"/>
            <Setter Property="Background" Value="#2D251D"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#191613"/>
            <Setter Property="BorderBrush" Value="#554638"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#302821"/>
            <Setter Property="BorderBrush" Value="#554638"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="#191613"/>
            <Setter Property="BorderBrush" Value="#3C3128"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Application.Styles>
</Application>
